{ ... }:
{
  # =============================================================
  # 机型共享配置：笔记本
  # =============================================================
  # 所有笔记本共用、与具体型号无关的部分写这里；
  # 型号专属(背光设备、显卡、输出名/缩放等)写到 hosts/<主机名>/default.nix。

  # 电源 / 电池 / 合盖等
  services.upower.enable = true;

  # 提示：内屏亮度由核显控制。若出现「只有 acpi_video0/1、调不动」，
  # 常见修法是强制原生背光（在具体 host 里开，避免影响不需要的机器）：
  #   boot.kernelParams = [ "acpi_backlight=native" ];   # AMD/Intel 核显
  # 若 native 无效或黑屏，改试 "acpi_backlight=vendor"。
}
