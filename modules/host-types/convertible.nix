{ ... }:
{
  # =============================================================
  # 机型共享配置：二合一(平板/翻转本)
  # =============================================================
  # 在笔记本基础上，额外需要传感器/触摸/旋转支持。

  services.upower.enable = true;

  # iio-sensor-proxy：提供加速度计/环境光等，供自动旋转、自动亮度使用
  hardware.sensor.iio.enable = true;

  # 提示：平板模式下的虚拟键盘、屏幕旋转绑定属于用户侧，
  # 可在 modules/features/ 里新增对应功能，或按机器在 host 里补。
}
