{ pkgs, ... }:
{
  # =============================================================
  # 机型共享配置：mini 主机
  # =============================================================
  # 定位接近台式：无电池、通常接外屏。

  # 若接外接显示器且需要调亮度，DDC/CI：
  boot.kernelModules = [ "i2c-dev" ];
  environment.systemPackages = [ pkgs.ddcutil ];

  # 提示：mini 主机常带核显，若内屏/外屏亮度异常按实际机型在 host 里处理。
}
